# Server
NODE_ENV=development
PORT=3001
# Set to 1 only when deployed behind one trusted reverse proxy; otherwise leave blank.
TRUST_PROXY=

# MongoDB Atlas (replace all placeholders; never commit the real URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fireplace_loader?retryWrites=true&w=majority

# Generate separate random secrets (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_unique_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated exact browser origins. Do not use * in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# App Config
APP_NAME=Fireplace Loader
APP_VERSION=4.6.0
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false
